# --- Conexión a PostgreSQL ---
# La base es un PostgreSQL local; nada del proyecto usa Supabase.
DATABASE_URL=postgresql://postgres:admin@localhost:5432/app_iunav?schema=public
# El default de src/config/env.ts es SSL ACTIVADO, así que `false` es
# obligatorio contra un PostgreSQL local sin TLS. Solo poner `true` para un
# servicio remoto que exija cifrado (Neon, RDS, Supabase).
DB_SSL=false
# Conexiones simultaneas a PostgreSQL. Es el techo real de concurrencia: con 10,
# 1000 estudiantes a la vez empiezan a recibir errores de conexion (medido en
# docs/Prueba-de-Carga.md). Para 60-80 usuarios concurrentes 10 sobra; para
# varios cientos, subirlo a 25-50 sin pasar del max_connections de PostgreSQL.
DB_POOL_MAX=10
# Base aislada para `npm test`, cuyo nombre debe terminar en `_test`.
TEST_DATABASE_URL=postgresql://postgres:admin@localhost:5432/app_iunav_test

# --- Seguridad ---
# Generar con: openssl rand -hex 32
# En la VPS lo genera deploy/instalar.sh y vive en /etc/iunav/server.env.
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h

# --- API ---
NODE_ENV=development
PORT=4000
# Interfaz donde escucha el Express. El default es 127.0.0.1 y debe seguir asi
# en la VPS: quien entra es Caddy, no internet (ver deploy/Caddyfile). Subirlo
# a 0.0.0.0 solo si el proxy vive en otra máquina (contenedor).
API_HOST=127.0.0.1
FRONTEND_URL=http://localhost:3000

# --- Archivos subidos ---
# Relativo a la raíz de server/. Los archivos NO se sirven como estáticos: pasan
# por GET /api/archivos/:carpeta/:nombre, que exige token.
UPLOAD_DIR=uploads
MAX_EVIDENCIA_MB=10
MAX_DOCUMENTO_MB=25

# --- Límite de intentos de login ---
# Tiene default en src/config/env.ts, pero conviene fijarlo:
# 10 intentos por IP cada 15 minutos.
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_VENTANA_MS=900000

# --- Correo saliente (notificaciones) ---
# El modulo de notificaciones manda el correo de bienvenida con la clave
# temporal y los avisos de avance del servicio comunitario.
#
# SIN SMTP_HOST el modulo queda inerte: las notificaciones se encolan en la
# tabla `notificaciones` con estado "pendiente" y se pueden reintentar desde
# Configuraciones > Notificaciones cuando haya servidor, pero no sale ningun
# correo. La instalacion local (local/instalar.cmd) funciona sin internet, asi
# que ahi es normal dejarlo vacio.
SMTP_HOST=
SMTP_PORT=587
# true solo con TLS directo (puerto 465). En 587 se usa STARTTLS: dejar en false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente que vera el destinatario. Si se deja vacio se usa SMTP_USER.
SMTP_DESDE=
